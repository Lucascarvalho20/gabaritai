{
  "extends": "next/core-web-vitals",
  "ignorePatterns": ["node_modules/", ".next/", "prisma/"],
  "rules": {
    "react/no-unescaped-entities": [
      "error",
      {
        "forbid": [
          { "char": ">", "alternatives": ["&gt;"] },
          { "char": "}", "alternatives": ["&#125;"] }
        ]
      }
    ]
  }
}
