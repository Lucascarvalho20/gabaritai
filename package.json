{
  "name": "@gabaritai/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verificar": "npm run typecheck && npm run lint && npm run test",
    "test:integracao": "bash tests/integracao/rodar.sh",
    "ci:fumaca": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ci/fumaca.ts",
    "ci:auditoria": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ci/auditoria.ts",
    "ci:migracoes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ci/migracoes-pendentes.ts",
    "mcp": "node --experimental-transform-types --no-warnings --import ./scripts/alias/registrar.mjs ./mcp/servidor.ts",
    "seed": "node prisma/seed-plans.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.0",
    "@prisma/client": "^5.15.0",
    "@tanstack/react-query": "^5.40.0",
    "axios": "^1.21.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.11",
    "jose": "^5.6.3",
    "katex": "^0.19.1",
    "lucide-react": "^0.395.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "recharts": "^2.12.7",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.33",
    "prisma": "^5.15.0",
    "tailwindcss": "^3.4.4",
    "typescript": "5.9.3"
  }
}
