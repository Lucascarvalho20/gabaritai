# Next.js
.next/
out/
next-env.d.ts

# Dependencies
node_modules/

# ─── SEGREDOS ───────────────────────────────────────────────────────────────
# Amplo de propósito: qualquer .env em qualquer nível, menos os .example
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12

# Build
dist/
build/
*.tsbuildinfo

# ─── DADOS / OPERAÇÃO — não vai pro repo público ────────────────────────────
# SQL ad-hoc: seeds de conteúdo (questões, editais) e scripts de operação.
# É acervo do negócio e ruído puro pra quem lê o código. As migrations
# oficiais do Prisma (prisma/migrations/*/migration.sql) continuam versionadas.
prisma/migrations/*.sql
supabase-schema.sql

# Documentação interna / briefings
ANTIGRAVITY_CONTEXT.md
BRIEFINGS_ANTIGRAVITY.md
CHAVES_API.md
DEPLOY_VERCEL.md
SETUP_DEPLOY.md
GUIA_MARKETING.md
PARA_OS_AMIGOS.md

# Scripts soltos de análise
check_*.js

# OS / logs
.DS_Store
*.log
npm-debug.log*
.vscode/
.claude/

# SQL que contenha hash de senha ou credencial — nunca versionar
prisma/sql/*admin*.sql
prisma/sql/*senha*.sql
prisma/sql/*credencial*.sql

# Workflow do CI: so entra quando houver token com escopo `workflow`.
# O arquivo existe em .github/workflows/verificar.yml, fora do git por enquanto.
.github/
