# ════════════════════════════════════════════════════════════════════════════
# Variáveis de ambiente do Gabaritai
#
# Copie para `.env` e preencha. Nenhum valor real vai para o repositório.
#
# Segredo sem valor em PRODUÇÃO é erro, não fallback: o código se recusa a usar
# chave padrão (src/lib/segredo.ts). Em `next dev`, os de CPF/telefone têm
# valor de desenvolvimento para o projeto subir sem configuração.
#
# Para gerar qualquer segredo aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ════════════════════════════════════════════════════════════════════════════

# ─── BANCO (obrigatório) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://gabaritai:gabaritai123@localhost:5432/gabaritai"

# ─── URLS (obrigatório) ─────────────────────────────────────────────────────
# Monta o retorno do login do Google e a URL de notificação do Mercado Pago.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
# Endereço público, usado no sitemap, robots e card de compartilhamento.
# Cole sem espaço nem quebra de linha no fim (o código normaliza, mas cole limpo).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── SESSÃO (obrigatório) ───────────────────────────────────────────────────
# Assina o JWT do cookie de sessão. Sem ele, produção não sobe.
JWT_SECRET=""

# ─── DADOS PESSOAIS — LGPD (obrigatório em produção) ────────────────────────
# CPF: hash com salt (unicidade) + AES-256-GCM (reversível). Ver src/lib/cpf.ts.
CPF_SALT=""
CPF_ENCRYPTION_KEY=""
# Telefone: opcionais — sem eles, reaproveitam as chaves do CPF.
# PHONE_SALT=""
# PHONE_ENCRYPTION_KEY=""

# ─── MERCADO PAGO (obrigatório para vender) ─────────────────────────────────
# developers → Suas integrações → aplicação → Credenciais:
#   TEST-...    sandbox, sem cobrança real
#   APP_USR-... produção (exige "ativar credenciais de produção" no painel)
MERCADOPAGO_ACCESS_TOKEN=""
# Webhooks → URL https://SEU_DOMINIO/api/payments/webhook, evento "payment",
# preencher a URL de PRODUÇÃO (não só a de teste). Copie a assinatura secreta:
MERCADOPAGO_WEBHOOK_SECRET=""
# Opcionais:
# MERCADOPAGO_SANDBOX="true"   # força sandbox mesmo com token APP_USR-
# NEXT_PUBLIC_MP_READY="true"  # esconde o aviso de "modo dev" no checkout

# ─── LOGIN COM GOOGLE (opcional) ────────────────────────────────────────────
# console.cloud.google.com → Credenciais → ID do cliente OAuth (Aplicativo da Web)
# URIs de redirecionamento: http://localhost:3000/api/auth/google/callback
#                           https://SEU_DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── IA (ao menos uma) ──────────────────────────────────────────────────────
# Gemini: IA principal E embeddings da busca semântica (RAG). Tem cota grátis.
GEMINI_API_KEY=""
# Groq: grátis, rápido; primeiro da fila no agente de diagnóstico.
GROQ_API_KEY=""
# Pagos, entram como reserva:
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
# Trocar modelo sem mexer no código (opcionais):
# GEMINI_MODEL=""  OPENAI_MODEL=""  CLAUDE_MODEL=""  DEEPSEEK_MODEL=""

# ─── E-MAIL — Resend (opcional) ─────────────────────────────────────────────
# Vazio em dev: os e-mails aparecem no console.
RESEND_API_KEY=""
EMAIL_FROM="Gabaritai <contato@SEU_DOMINIO>"

# ─── TELEGRAM — avisos para o admin (opcional) ──────────────────────────────
# @BotFather → /newbot → token. Mande "oi" ao bot e abra
# https://api.telegram.org/bot<TOKEN>/getUpdates para achar o chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── CRONS (obrigatório para as tarefas agendadas) ──────────────────────────
# A Vercel só envia o segredo nos agendamentos se a variável se chamar
# CRON_SECRET. CRON_TOKEN serve para chamar uma rota de cron à mão.
# O site aceita qualquer uma das duas. Sem nenhuma, os crons ficam desligados.
CRON_SECRET=""
CRON_TOKEN=""

# ─── SETUP E ADMIN (opcional) ───────────────────────────────────────────────
# Protege /api/setup/* e o diagnóstico completo do /api/health. Mínimo 24 chars.
SETUP_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── CAPTAÇÃO (opcional) ────────────────────────────────────────────────────
# LEAD_REQUIRE_SIGNUP="false"  # aceita lead sem cadastro completo
