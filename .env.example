# ─── BANCO DE DADOS (Postgres) ──────────────────────────────────────────────
DATABASE_URL="postgresql://gabaritai:gabaritai123@localhost:5432/gabaritai"

# ─── URL BASE (front + back compartilham — Next.js fullstack) ───────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Em produção:
# NEXT_PUBLIC_BASE_URL="https://gabaritai.app"
# NEXT_PUBLIC_API_URL="https://gabaritai.app/api"

# ─── AUTH ───────────────────────────────────────────────────────────────────
JWT_SECRET="TROQUE-POR-32-CHARS-ALEATORIOS-EM-PROD"
NEXTAUTH_SECRET="TROQUE-POR-32-CHARS-ALEATORIOS-EM-PROD"
NEXTAUTH_URL="http://localhost:3000"

# ─── CPF ENCRYPTION (AES-256-GCM) ───────────────────────────────────────────
# Chave de 32 bytes em hex (64 chars). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_ENCRYPTION_KEY=""

# ─── MERCADO PAGO ───────────────────────────────────────────────────────────
# 1) Conta MP → https://www.mercadopago.com.br/developers/panel
# 2) "Suas integrações" → criar aplicação (modo TEST primeiro pra testar)
# 3) "Credenciais" → copia o Access Token:
#    - TEST-... (sandbox, sem cobrança real)
#    - APP_USR-... (produção, cobra de verdade)
MERCADOPAGO_ACCESS_TOKEN=""

# 4) Pra webhook em produção: "Webhooks" → "Configurar notificações"
#    - URL: https://SEU_DOMINIO/api/payments/webhook
#    - Eventos: payment
#    - Modo: produção (não simulação)
#    - Copia a CHAVE SECRETA (clica "Visualizar chave secreta") e cola aqui:
MERCADOPAGO_WEBHOOK_SECRET=""

# Flag pública pra esconder banner "modo dev" do checkout
NEXT_PUBLIC_MP_READY=""

# ─── GOOGLE OAUTH ───────────────────────────────────────────────────────────
# 1) https://console.cloud.google.com/apis/credentials
# 2) "Criar credenciais" → "ID do cliente OAuth" → tipo "Aplicativo da Web"
# 3) URIs de redirecionamento autorizados:
#    - http://localhost:3000/api/auth/google/callback
#    - https://SEU_DOMINIO/api/auth/google/callback
# 4) Copia ID + chave secreta abaixo:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── EMAIL (Resend.com) ─────────────────────────────────────────────────────
# Em DEV deixa vazio — emails aparecem no console.
# Em prod: https://resend.com → API Keys → copia "re_..."
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Gabaritai <contato@gabaritai.app>"

# ─── TELEGRAM (notificações pro admin) ──────────────────────────────────────
# 1) Fala com @BotFather no Telegram → /newbot → segue passos → copia token
# 2) Fala "oi" pro seu bot → acessa https://api.telegram.org/bot<TOKEN>/getUpdates
#    → pega o "chat":{"id": NUMERO} e cola aqui
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ─── IA (fallback chain: Claude → Groq → OpenAI) ────────────────────────────
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# ─── CRON (token bearer pra proteger endpoints /api/cron/*) ─────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_TOKEN="gabaritai-dev-cron-token"

# ─── ADMIN INICIAL ──────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@gabaritai.app"
ADMIN_PASSWORD="TROQUE-NA-PRIMEIRA-VEZ"
